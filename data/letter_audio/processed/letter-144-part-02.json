  "speed": 0.9,
  "clips": [
    {
      "index": 10,
      "text": "Why this hurry to die?",
      "path": "audio/1970-144/11.mp3",
      "start": 0.0,
      "end": 1.488753
    },
    {
      "index": 11,
      "text": "Death itself will take care of that for us so is it not right that we learn to live?",
      "path": "audio/1970-144/12.mp3",
      "start": 2.954354,
      "end": 7.760862
    },
    {
      "index": 12,
      "text": "And the miracle is that death does not call on the one who learns how to live - and this alone is needed.",
      "path": "audio/1970-144/13.mp3",
      "start": 9.249274000000002,
      "end": 15.931496999999998
    },
    {
      "index": 13,
      "text": "Doesn't the gardener silently wait after sowing the seed?",
      "path": "audio/1970-144/14.mp3",
      "start": 17.545125,
      "end": 21.215465000000002
    },
    {
      "index": 14,
      "text": "Whenever you need me you will find me beside you.",
      "path": "audio/1970-144/15.mp3",
      "start": 22.744286,
      "end": 25.753379000000002
    },
    {
      "index": 15,
      "text": "Regards to all there.",
      "path": "audio/1970-144/16.mp3",
      "start": 27.19195,
      "end": 28.97
    }
  ]
}
