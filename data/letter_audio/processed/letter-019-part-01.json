  "generationId": "01a1e4ea-6ac3-7066-be9a-0c834dab5c04",
  "voice": "Views",
  "speed": 0.9,
  "clips": [
    {
      "index": 0,
      "text": "My respects to you.",
      "path": "audio/1964-19/01.mp3",
      "start": 0.0,
      "end": 1.259478
    },
    {
      "index": 1,
      "text": "Your letters were received.",
      "path": "audio/1964-19/02.mp3",
      "start": 2.5408619999999997,
      "end": 4.032766
    },
    {
      "index": 2,
      "text": "I have just got back from a camp at Ranakpur.",
      "path": "audio/1964-19/03.mp3",
      "start": 5.306961,
      "end": 7.975873
    },
    {
      "index": 3,
      "text": "It was just for friends from Rajasthan, that's why you weren't informed.",
      "path": "audio/1964-19/04.mp3",
      "start": 9.293039,
      "end": 13.683356
    },
    {
      "index": 4,
      "text": "It lasted five days and about sixty people participated.",
      "path": "audio/1964-19/05.mp3",
      "start": 14.979229,
      "end": 19.070612
    },
    {
      "index": 5,
      "text": "It was a wonderful success and it was obvious that much happened.",
      "path": "audio/1964-19/06.mp3",
      "start": 20.383039,
      "end": 24.283469
    },
    {
      "index": 6,
      "text": "Encouraged by the results the organizers are planning a camp on an all-India basis.",
      "path": "audio/1964-19/07.mp3",
      "start": 25.730227,
      "end": 30.883016
    },
    {
      "index": 7,
      "text": "You must come to that.",
      "path": "audio/1964-19/08.mp3",
      "start": 32.461474,
      "end": 33.941451
    },
    {
      "index": 8,
      "text": "I am glad to hear your meditation is progressing.",
      "path": "audio/1964-19/09.mp3",
      "start": 35.619116000000005,
      "end": 38.316463
    },
    {
      "index": 9,
      "text": "You have only to be silent.",
      "path": "audio/1964-19/10.mp3",
      "start": 39.771474000000005,
      "end": 41.69
    }
  ]
}
