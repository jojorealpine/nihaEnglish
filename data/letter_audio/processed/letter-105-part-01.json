  "clips": [
    {
      "index": 0,
      "text": "Love.",
      "path": "audio/1970-105/01.mp3",
      "start": 0.0,
      "end": 0.539025
    },
    {
      "index": 1,
      "text": "Do not desire bliss because that desire gets in the way.",
      "path": "audio/1970-105/02.mp3",
      "start": 1.903537,
      "end": 4.848889
    },
    {
      "index": 2,
      "text": "Live life unchained to desire and without an eye on a goal.",
      "path": "audio/1970-105/03.mp3",
      "start": 6.1518369999999996,
      "end": 9.996507999999999
    },
    {
      "index": 3,
      "text": "Live free!",
      "path": "audio/1970-105/04.mp3",
      "start": 11.260567,
      "end": 12.196235999999999
    },
    {
      "index": 4,
      "text": "Live from moment to moment!",
      "path": "audio/1970-105/05.mp3",
      "start": 13.516871,
      "end": 14.969795999999999
    },
    {
      "index": 5,
      "text": "And don't be afraid, be free of fear because there is nothing to lose - and nothing to gain - and the moment you realize this the totality of life is attained.",
      "path": "audio/1970-105/06.mp3",
      "start": 16.243356,
      "end": 25.458685000000003
    },
    {
      "index": 6,
      "text": "But never approach the gates of life as a beggar, never go begging, for those gates never open to beggars!",
      "path": "audio/1970-105/07.mp3",
      "start": 27.070567,
      "end": 34.35
    }
  ]
}
