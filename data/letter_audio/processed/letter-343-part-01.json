{
  "key": "letter-343-part-01",
  "number": 343,
  "generationId": "01a1e914-8ed1-734e-8d75-32d0d25152d5",
  "voice": "Views",
  "speed": 0.9,
  "clips": [
    {
      "index": 0,
      "text": "Love.",
      "path": "audio/1971-343/01.mp3",
      "start": 0.0,
      "end": 0.671088
    },
    {
      "index": 1,
      "text": "A traveler stops at an inn: he passes the night there, takes his meal, and as soon as he has done so he packs and continues his journey again.",
      "path": "audio/1971-343/02.mp3",
      "start": 2.582041,
      "end": 10.558912
    },
    {
      "index": 2,
      "text": "As for the host of the inn, he has nowhere to go.",
      "path": "audio/1971-343/03.mp3",
      "start": 11.91576,
      "end": 14.997822999999999
    },
    {
      "index": 3,
      "text": "The one who does not stay is the guest, and the one who stays is the host.",
      "path": "audio/1971-343/04.mp3",
      "start": 16.412516999999998,
      "end": 21.020408
    },
    {
      "index": 4,
      "text": "Now who are you - the guest or the host?",
      "path": "audio/1971-343/05.mp3",
      "start": 22.345986,
      "end": 24.755850000000002
    },
    {
      "index": 5,
      "text": "Meditate.",
      "path": "audio/1971-343/06.mp3",
      "start": 26.02424,
      "end": 26.764308
    },
    {
      "index": 6,
      "text": "No answer is required, rather, realize, because all answers belong to the guest and realization only to the host.",
      "path": "audio/1971-343/07.mp3",
      "start": 28.042652999999998,
      "end": 33.856372
    },
    {
      "index": 7,
      "text": "But do not believe me, I may be just deceiving you.",
      "path": "audio/1971-343/08.mp3",
      "start": 35.159252,
      "end": 38.149477999999995
    },
    {
      "index": 8,
      "text": "Go in and find out for yourself!",
      "path": "audio/1971-343/09.mp3",
      "start": 39.616825000000006,
      "end": 41.56
    }
  ]
}
