  "speed": 0.9,
  "clips": [
    {
      "index": 0,
      "text": "Love.",
      "path": "audio/1971-275/01.mp3",
      "start": 0.0,
      "end": 0.688957
    },
    {
      "index": 1,
      "text": "A disciple of Rinzai met a party of three men on a bridge.",
      "path": "audio/1971-275/02.mp3",
      "start": 2.16093,
      "end": 5.52644
    },
    {
      "index": 2,
      "text": "One of the three asked him: How deep is the river of meditation?",
      "path": "audio/1971-275/03.mp3",
      "start": 6.853628,
      "end": 10.777482999999998
    },
    {
      "index": 3,
      "text": "Find out for yourself, he said, and offered to throw the questioner from the bridge.",
      "path": "audio/1971-275/04.mp3",
      "start": 12.144966,
      "end": 16.195556
    },
    {
      "index": 4,
      "text": "But unfortunately the man ran away from him in time and escaped.",
      "path": "audio/1971-275/05.mp3",
      "start": 17.509206,
      "end": 21.18907
    },
    {
      "index": 5,
      "text": "If you meet such a man, who can throw you in the river, be fortunate enough to be thrown!",
      "path": "audio/1971-275/06.mp3",
      "start": 22.677754999999998,
      "end": 27.860907
    },
    {
      "index": 6,
      "text": "And you have met such a man!",
      "path": "audio/1971-275/07.mp3",
      "start": 29.389319999999998,
      "end": 31.424580000000002
    },
    {
      "index": 7,
      "text": "Now be thrown.",
      "path": "audio/1971-275/08.mp3",
      "start": 32.851338000000005,
      "end": 34.46
    }
  ]
}
