      "end": 9.617483
    },
    {
      "index": 2,
      "text": "A madman was throwing handfuls of crumbs around his house.",
      "path": "audio/1971-248/03.mp3",
      "start": 10.970045,
      "end": 14.582766
    },
    {
      "index": 3,
      "text": "What are you doing? someone asked him.",
