  "clips": [
    {
      "index": 0,
      "text": "Love.",
      "path": "audio/1971-164/01.mp3",
      "start": 0.0,
      "end": 0.569206
    },
    {
      "index": 1,
      "text": "You ask: how far is the destination?",
      "path": "audio/1971-164/02.mp3",
      "start": 1.714467,
      "end": 4.244762
    },
    {
      "index": 2,
      "text": "Ah!",
      "path": "audio/1971-164/03.mp3",
      "start": 5.395941,
      "end": 5.940181
    },
    {
      "index": 3,
      "text": "The destination is very far, and very near too.",
      "path": "audio/1971-164/04.mp3",
      "start": 7.246803,
      "end": 10.171678
    },
    {
      "index": 4,
      "text": "And the distance or the nearness of the destination is not dependent on the destination but upon you yourself.",
      "path": "audio/1971-164/05.mp3",
      "start": 11.373923000000001,
      "end": 16.749728
    },
    {
      "index": 5,
      "text": "The deeper the will, the nearer the destination.",
      "path": "audio/1971-164/06.mp3",
      "start": 17.983401,
      "end": 20.648095
    },
    {
      "index": 6,
      "text": "If the will is total, then you yourself are the destination.",
      "path": "audio/1971-164/07.mp3",
      "start": 22.186508,
      "end": 26.17
    }
  ]
}
