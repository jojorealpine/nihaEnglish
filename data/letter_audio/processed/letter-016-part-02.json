  "clips": [
    {
      "index": 10,
      "text": "Have you ever seen this happen?",
      "path": "audio/1964-16/11.mp3",
      "start": 0.0,
      "end": 1.398435
    },
    {
      "index": 11,
      "text": "See this, fill yourself with love and see.",
      "path": "audio/1964-16/12.mp3",
      "start": 2.6887529999999997,
      "end": 5.671995
    },
    {
      "index": 12,
      "text": "Whatever breaks up the inner music - that alone is irreligious, that alone is sin.",
      "path": "audio/1964-16/13.mp3",
      "start": 7.048435,
      "end": 11.875010999999999
    },
    {
      "index": 13,
      "text": "And whatever fills us with music - that is religion, that alone is religion.",
      "path": "audio/1964-16/14.mp3",
      "start": 13.132018,
      "end": 18.486122
    },
    {
      "index": 14,
      "text": "Love is religion because love is beauty, love is music.",
      "path": "audio/1964-16/15.mp3",
      "start": 19.691224,
      "end": 24.007098000000003
    },
    {
      "index": 15,
      "text": "Love is God because it is all that is needed to attain him.",
      "path": "audio/1964-16/16.mp3",
      "start": 25.671701,
      "end": 29.764853000000002
    },
    {
      "index": 16,
      "text": "Give my love to everybody there and feel the light of my love beside you.",
      "path": "audio/1964-16/17.mp3",
      "start": 31.2578,
      "end": 35.89
    }
  ]
}
