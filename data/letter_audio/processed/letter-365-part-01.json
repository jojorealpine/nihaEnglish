{
  "key": "letter-365-part-01",
  "number": 365,
  "generationId": "01a1e919-b5d4-735f-8562-669d40238edb",
  "voice": "Views",
  "speed": 0.9,
  "clips": [
    {
      "index": 0,
      "text": "Love.",
      "path": "audio/1971-365/01.mp3",
      "start": 0.0,
      "end": 0.5809519999999999
    },
    {
      "index": 1,
      "text": "You will become more deeply tied to whatever you desire to become free from.",
      "path": "audio/1971-365/02.mp3",
      "start": 1.768685,
      "end": 5.662404
    },
    {
      "index": 2,
      "text": "Because freedom is not negation.",
      "path": "audio/1971-365/03.mp3",
      "start": 6.851247,
      "end": 8.884082
    },
    {
      "index": 3,
      "text": "Freedom is not 'from something' or 'for something' Freedom is not positive either.",
      "path": "audio/1971-365/04.mp3",
      "start": 10.109592000000001,
      "end": 16.39898
    },
    {
      "index": 4,
      "text": "Freedom is the transcendence of negation and affirmation both.",
      "path": "audio/1971-365/05.mp3",
      "start": 17.612697999999998,
      "end": 21.483741000000002
    },
    {
      "index": 5,
      "text": "Freedom means freedom from duality.",
      "path": "audio/1971-365/06.mp3",
      "start": 22.969751,
      "end": 25.39517
    },
    {
      "index": 6,
      "text": "Where is a 'for or against' there?",
      "path": "audio/1971-365/07.mp3",
      "start": 27.024670999999998,
      "end": 30.025578
    },
    {
      "index": 7,
      "text": "With what to react?",
      "path": "audio/1971-365/08.mp3",
      "start": 31.480294999999998,
      "end": 32.929500999999995
    },
    {
      "index": 8,
      "text": "What rebellion?",
      "path": "audio/1971-365/09.mp3",
      "start": 34.433107,
      "end": 35.749750999999996
    },
    {
      "index": 9,
      "text": "Reaction is not wisdom.",
      "path": "audio/1971-365/10.mp3",
      "start": 37.248503,
      "end": 39.84
    }
  ]
}
