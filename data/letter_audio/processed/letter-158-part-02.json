  "speed": 0.9,
  "clips": [
    {
      "index": 10,
      "text": "Partiality won't do.",
      "path": "audio/1970-158/11.mp3",
      "start": 0.0,
      "end": 1.768685
    },
    {
      "index": 11,
      "text": "Meditation is not possible without your totality.",
      "path": "audio/1970-158/12.mp3",
      "start": 3.170136,
      "end": 6.9251700000000005
    },
    {
      "index": 12,
      "text": "Hence, stay with the act of meditation and leave the fruit of meditation in the hands of the divine.",
      "path": "audio/1970-158/13.mp3",
      "start": 8.395601000000001,
      "end": 14.958457999999998
    },
    {
      "index": 13,
      "text": "And the fruit comes.",
      "path": "audio/1970-158/14.mp3",
      "start": 16.523899999999998,
      "end": 17.9361
    },
    {
      "index": 14,
      "text": "Because drowning totally in meditation is the birth of the fruit.",
      "path": "audio/1970-158/15.mp3",
      "start": 19.389523999999998,
      "end": 23.72
    }
  ]
}
