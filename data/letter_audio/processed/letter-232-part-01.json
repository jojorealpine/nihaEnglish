  "voice": "Views",
  "speed": 0.9,
  "clips": [
    {
      "index": 0,
      "text": "Love.",
      "path": "audio/1971-232/01.mp3",
      "start": 0.0,
      "end": 0.5403169999999999
    },
    {
      "index": 1,
      "text": "Man asks questions and then answers them himself.",
      "path": "audio/1971-232/02.mp3",
      "start": 1.501814,
      "end": 4.300952
    },
    {
      "index": 2,
      "text": "Nothing is answered in this way.",
      "path": "audio/1971-232/03.mp3",
      "start": 5.354014,
      "end": 6.73449
    },
    {
      "index": 3,
      "text": "But man is capable of deceiving himself - and the whole of philosophy is nothing but such a deception.",
      "path": "audio/1971-232/04.mp3",
      "start": 7.828345,
      "end": 13.098049999999999
    },
    {
      "index": 4,
      "text": "Man asks: What is mind?",
      "path": "audio/1971-232/05.mp3",
      "start": 14.126281,
      "end": 15.905488
    },
    {
      "index": 5,
      "text": "And then answers himself: Not matter?",
      "path": "audio/1971-232/06.mp3",
      "start": 17.052721,
      "end": 19.821429000000002
    },
    {
      "index": 6,
      "text": "And then asks: What is matter?",
      "path": "audio/1971-232/07.mp3",
      "start": 21.330883999999998,
      "end": 23.327891
    },
    {
      "index": 7,
      "text": "And then answers: Not mind?",
      "path": "audio/1971-232/08.mp3",
      "start": 24.888956999999998,
      "end": 27.190862000000003
    },
    {
      "index": 8,
      "text": "And this stupid game goes on.",
      "path": "audio/1971-232/09.mp3",
      "start": 28.735509999999998,
      "end": 30.509819
    },
    {
      "index": 9,
      "text": "I have heard about a distinguished philosopher who always began his speeches with: Why are we here?",
      "path": "audio/1971-232/10.mp3",
      "start": 31.954263,
      "end": 38.3
    }
  ]
}
