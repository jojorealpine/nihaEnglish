    {
      "index": 0,
      "text": "Love.",
      "path": "audio/1969-68/01.mp3",
      "start": 0.0,
      "end": 0.621519
    },
    {
      "index": 1,
      "text": "Leave the old track - only the dead walk on trodden paths.",
      "path": "audio/1969-68/02.mp3",
      "start": 1.8805899999999998,
      "end": 5.92805
    },
    {
      "index": 2,
      "text": "Life is the continuous quest for the new.",
      "path": "audio/1969-68/03.mp3",
      "start": 7.278163,
      "end": 9.740113
    },
    {
      "index": 3,
      "text": "Only he who has the knack of being new every moment truly lives.",
      "path": "audio/1969-68/04.mp3",
      "start": 11.061519,
      "end": 15.69966
    },
    {
      "index": 4,
      "text": "Die to the old every moment so that you are forever new - this is the crux of the transformation of life.",
      "path": "audio/1969-68/05.mp3",
      "start": 17.000771,
      "end": 23.72
    }
  ]
