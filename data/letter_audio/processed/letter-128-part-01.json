{
  "key": "letter-128-part-01",
  "number": 128,
  "generationId": "01a1e6c0-27a3-78fe-bec4-ed166ddb1f12",
  "voice": "Views",
  "speed": 0.9,
  "clips": [
    {
      "index": 0,
      "text": "Love.",
      "path": "audio/1970-128/01.mp3",
      "start": 0.0,
      "end": 0.742744
    },
    {
      "index": 1,
      "text": "Be like steel - clay will no longer do.",
      "path": "audio/1970-128/02.mp3",
      "start": 2.066168,
      "end": 4.400068
    },
    {
      "index": 2,
      "text": "To be a sannyasin is to be a soldier of God.",
      "path": "audio/1970-128/03.mp3",
      "start": 5.49458,
      "end": 7.963787
    },
    {
      "index": 3,
      "text": "Serve your parents - even more than before.",
      "path": "audio/1970-128/04.mp3",
      "start": 9.026372,
      "end": 11.507845999999999
    },
    {
      "index": 4,
      "text": "Give them the joy of a sannyasin son.",
      "path": "audio/1970-128/05.mp3",
      "start": 12.638798000000001,
      "end": 14.830884
    },
    {
      "index": 5,
      "text": "But don't relent, keep your resolution firm; it will bring glory to your family.",
      "path": "audio/1970-128/06.mp3",
      "start": 15.951814,
      "end": 20.347188000000003
    },
    {
      "index": 6,
      "text": "The son who compromises with a thing like sannyas shames his family.",
      "path": "audio/1970-128/07.mp3",
      "start": 21.971881999999997,
      "end": 25.728776
    },
    {
      "index": 7,
      "text": "I have complete trust in you, that's why I have been a witness to your sannyas.",
      "path": "audio/1970-128/08.mp3",
      "start": 27.223764,
      "end": 31.717483
    },
    {
      "index": 8,
      "text": "Laugh and go through everything.",
      "path": "audio/1970-128/09.mp3",
      "start": 33.182676,
      "end": 34.963152
    },
    {
      "index": 9,
      "text": "Listen to everything and laugh.",
      "path": "audio/1970-128/10.mp3",
      "start": 36.396553000000004,
      "end": 38.48
    }
  ]
}
