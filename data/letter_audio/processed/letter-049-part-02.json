    },
    {
      "index": 11,
      "text": "Love turns even a moment into eternity.",
      "path": "audio/1968-49/12.mp3",
      "start": 2.773628,
      "end": 5.409274
    },
    {
      "index": 12,
      "text": "Where there is love there is nothing momentary, where there is love there is eternity.",
      "path": "audio/1968-49/13.mp3",
      "start": 6.584966,
      "end": 11.946803
    },
    {
      "index": 13,
      "text": "Is a drop just a drop?",
