    },
    {
      "index": 15,
      "text": "No!",
      "path": "audio/1968-49/16.mp3",
      "start": 17.030091,
      "end": 17.59
    },
    {
      "index": 16,
      "text": "It is the ocean!",
      "path": "audio/1968-49/17.mp3",
      "start": 18.644671,
      "end": 19.687279
    },
    {
      "index": 17,
      "text": "The drop seen through eyes of love becomes the ocean!",
