{
  "key": "letter-163-part-01",
  "number": 163,
  "generationId": "01a1e8e2-f57c-7319-abf3-98cb512b8e68",
  "voice": "Views",
  "speed": 0.9,
  "clips": [
    {
      "index": 0,
      "text": "Love.",
      "path": "audio/1971-163/01.mp3",
      "start": 0.0,
      "end": 0.531678
    },
    {
      "index": 1,
      "text": "You ask for the way to make the invisible visible?",
      "path": "audio/1971-163/02.mp3",
      "start": 1.7270750000000001,
      "end": 4.431633
    },
    {
      "index": 2,
      "text": "Pay attention to the visible.",
      "path": "audio/1971-163/03.mp3",
      "start": 5.59195,
      "end": 7.124263
    },
    {
      "index": 3,
      "text": "Do not just see, pay attention.",
      "path": "audio/1971-163/04.mp3",
      "start": 8.271701,
      "end": 10.406485
    },
    {
      "index": 4,
      "text": "It means, when you see a flower, let your whole being become the eye.",
      "path": "audio/1971-163/05.mp3",
      "start": 11.522721,
      "end": 15.950702999999999
    },
    {
      "index": 5,
      "text": "When you listen to the birds, let your entire body-soul become the ear.",
      "path": "audio/1971-163/06.mp3",
      "start": 17.112085999999998,
      "end": 21.533900000000003
    },
    {
      "index": 6,
      "text": "When you look at a flower, do not think.",
      "path": "audio/1971-163/07.mp3",
      "start": 22.917279,
      "end": 25.43542
    },
    {
      "index": 7,
      "text": "When you listen to birds, do not ponder.",
      "path": "audio/1971-163/08.mp3",
      "start": 26.910975,
      "end": 29.812653
    },
    {
      "index": 8,
      "text": "Let the total consciousness either see or hear or smell or taste or touch.",
      "path": "audio/1971-163/09.mp3",
      "start": 31.168502999999998,
      "end": 36.123787
    },
    {
      "index": 9,
      "text": "Because it is due to a shallowness of sensitivity that the invisible is unable to become visible, and the unknown remains unknown.",
      "path": "audio/1971-163/10.mp3",
      "start": 37.476712,
      "end": 46.65
    }
  ]
}
