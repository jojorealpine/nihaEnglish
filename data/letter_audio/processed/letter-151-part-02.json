  "speed": 0.9,
  "clips": [
    {
      "index": 10,
      "text": "Be here and now and see!",
      "path": "audio/1970-151/11.mp3",
      "start": 0.0,
      "end": 1.199773
    },
    {
      "index": 11,
      "text": "See the instant in time, see the atom in space.",
      "path": "audio/1970-151/12.mp3",
      "start": 2.145329,
      "end": 4.49458
    },
    {
      "index": 12,
      "text": "In the time moment time ceases to exist.",
      "path": "audio/1970-151/13.mp3",
      "start": 5.550884,
      "end": 7.558299
    },
    {
      "index": 13,
      "text": "In the space atom space ceases to exist.",
      "path": "audio/1970-151/14.mp3",
      "start": 8.606961,
      "end": 10.742336
    },
    {
      "index": 14,
      "text": "There is no space, no time, here and now.",
      "path": "audio/1970-151/15.mp3",
      "start": 11.811043000000002,
      "end": 14.263696
    },
    {
      "index": 15,
      "text": "What is left is truth, is God, is that.",
      "path": "audio/1970-151/16.mp3",
      "start": 15.358073000000001,
      "end": 17.96678
    },
    {
      "index": 16,
      "text": "You too are that.",
      "path": "audio/1970-151/17.mp3",
      "start": 19.087799999999998,
      "end": 20.011587000000002
    },
    {
      "index": 17,
      "text": "Tat twam asi - that art thou.",
      "path": "audio/1970-151/18.mp3",
      "start": 21.132970999999998,
      "end": 23.72
    }
  ]
}
