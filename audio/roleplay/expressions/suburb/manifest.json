      "path": "audio/roleplay/expressions/suburb/920814a0abacbab2.mp3",
      "generationId": "01a1ca6b-82c4-7323-9709-5cb14649acbc",
      "duration": 1.3322448979591837
    },
    {
      "text": "get in touch with someone",
      "path": "audio/roleplay/expressions/suburb/49f808def2af45a9.mp3",
      "generationId": "01a1ca6b-b60c-774a-b25e-4f0b6d3c2b69",
      "duration": 1.6718367346938776
    },
    {
      "text": "catch someone later",
      "path": "audio/roleplay/expressions/suburb/3a000edfd1c125b5.mp3",
      "generationId": "01a1ca6b-b880-7347-b814-825e4bee2572",
      "duration": 1.3322448979591837
    },
    {
