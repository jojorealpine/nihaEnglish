      "path": "audio/roleplay/expressions/suburb/22f233fcef74dafb.mp3",
      "generationId": "01a1ca6b-3f26-785c-95be-76c1a3384c26",
      "duration": 1.8546938775510204
    },
    {
      "text": "be cool with…",
      "path": "audio/roleplay/expressions/suburb/76bb7568d8a63178.mp3",
      "generationId": "01a1ca6b-633e-7d65-814c-1ab86c571aea",
      "duration": 0.9142857142857143
    },
    {
      "text": "a meeting runs until…",
      "path": "audio/roleplay/expressions/suburb/353601c432dfc724.mp3",
      "generationId": "01a1ca6b-78eb-7bb9-9670-4b2ef6c6205e",
      "duration": 1.4889795918367348
    },
    {
